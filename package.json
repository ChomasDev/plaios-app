{
  "name": "@plaios/app-dynamic",
  "version": "0.8.1",
  "description": "Dynamic PLAIOS runtime host and swappable microfrontend control plane",
  "keywords": [
    "plaios",
    "dynamic",
    "runtime",
    "microfrontend",
    "registry"
  ],
  "private": false,
  "type": "module",
  "bin": {
    "plaios-app": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "openui-spec.json",
    "src",
    "web",
    "README.md"
  ],
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/make-cli-executable.mjs",
    "dev": "tsx src/cli.ts",
    "prepack": "pnpm build",
    "test": "pnpm build && node --test dist/test/**/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "landing:dev": "vite landing --host 127.0.0.1",
    "landing:build": "vite build landing --outDir ../dist/landing --emptyOutDir",
    "landing:preview": "vite preview landing --outDir ../dist/landing --host 127.0.0.1"
  },
  "dependencies": {
    "@plaios/core": "workspace:*",
    "@plaios/microfrontend": "workspace:*",
    "@fontsource-variable/noto-sans": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openuidev/lang-core": "1.0.1",
    "@openuidev/react-headless": "0.18.1",
    "@openuidev/react-lang": "1.0.1",
    "@openuidev/react-ui": "0.18.1",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.90.2",
    "@vitejs/plugin-react": "^5.0.4",
    "framer-motion": "^14.6.0",
    "lucide-react": "^0.544.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.1.7",
    "yaml": "^2.8.1",
    "zod": "^4.6.7",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
