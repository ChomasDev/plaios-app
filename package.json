{
  "name": "@agent-os/app-dynamic",
  "version": "0.4.0",
  "description": "Dynamic Agent OS runtime host and swappable microfrontend control plane",
  "keywords": ["agent-os", "dynamic", "runtime", "microfrontend", "registry"],
  "private": false,
  "type": "module",
  "bin": {
    "agentos-app": "./dist/src/cli.js"
  },
  "files": ["dist", "src", "web", "README.md"],
  "main": "./dist/src/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/make-cli-executable.mjs",
    "dev": "tsx src/cli.ts",
    "prepack": "pnpm build",
    "test": "pnpm build && node --test dist/test/**/*.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@agent-os/core": "workspace:*",
    "@agent-os/microfrontend": "workspace:*",
    "@fontsource-variable/noto-sans": "^5.2.8",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.90.2",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.544.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.1.7",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
